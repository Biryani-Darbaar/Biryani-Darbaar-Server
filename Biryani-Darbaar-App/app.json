{
  "expo": {
    "name": "Biryani Darbaar",
    "slug": "biryani-darbaar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.biryanidarbaar.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Required for uploading photos via the website.",
        "NSPhotoLibraryUsageDescription": "Required for uploading photos via the website.",
        "NSMicrophoneUsageDescription": "Required for video recording via the website.",
        "NSLocationWhenInUseUsageDescription": "Used to find nearby restaurant locations.",
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.biryanidarbaar.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "imageWidth": 500
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
